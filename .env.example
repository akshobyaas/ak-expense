# Ixora — environment variables
# Set these in Vercel → Settings → Environment Variables.
# Keep a local copy in .env.local (gitignored) so scripts/push.mjs can use VAULT_API_KEY.

GOOGLE_SHEET_ID=your_sheet_id
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token
# Shared secret the app sends as X-Vault-Key (different from the vault's)
VAULT_API_KEY=long_random_string
# Lock the API to your site
ALLOWED_ORIGIN=https://expense8849.vercel.app
