# ak-expense — environment variables (set these in Vercel → Settings → Environment Variables)
# You can reuse the same Google OAuth client + refresh token as your vault.
GOOGLE_SHEET_ID=your_new_expense_sheet_id
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token
# Shared secret the app sends as X-Vault-Key. Use a different value from the vault's.
VAULT_API_KEY=long_random_string
# Optional: lock CORS to your deployed origin
ALLOWED_ORIGIN=https://your-project.vercel.app
